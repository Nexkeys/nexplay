{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && !newData.exists() && data.child('meta/hostUid').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
          ".validate": "!newData.exists() || newData.hasChildren(['code', 'game', 'hostUid', 'status'])",
          "hostUid": {
            ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists() && (newData.val() === auth.uid || data.val() === auth.uid)"
          },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'ended'" },
          "code": { ".validate": "newData.val() === $code" }
        },
        "players": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && ($pid === auth.uid || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'seat'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" }
          }
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid"
        },
        "host": {
          ".read": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid"
        },
        "views": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
          "$uid": { ".read": "auth != null && auth.uid === $uid" }
        },
        "errors": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !newData.exists()"
          }
        },
        "moves": {
          ".read": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
          "$move": {
            ".write": "auth != null && (newData.child('uid').val() === auth.uid && !data.exists() || !newData.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.hasChildren(['uid', 'match', 'move']) && newData.child('move').isString() && newData.child('move').val().length < 2000"
          }
        },
        "emotes": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
          "$e": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/' + $code + '/players/' + auth.uid).exists()",
            ".validate": "newData.child('e').isString() && newData.child('e').val().length <= 8"
          }
        }
      }
    },
    "queue": {
      "$game": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "matches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["xp"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'xp']) && newData.child('xp').isNumber() && newData.child('xp').val() >= 0 && (data.child('xp').exists() ? newData.child('xp').val() <= data.child('xp').val() + 320 : newData.child('xp').val() <= 320) && newData.child('name').isString() && newData.child('name').val().length <= 24"
      }
    }
  }
}
